<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#55FFFFFF"> <!-- Brilho claro ao pressionar -->

    <!-- Máscara que garante que o efeito respeite os 10dp de canto arredondado -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Seu fundo dourado original -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/gold_dark"
                android:startColor="@color/gold_bright" />
            <corners android:radius="10dp" />
        </shape>
    </item>

</ripple>
